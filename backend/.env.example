# ============================================================
#  Load Balancer Simulator — ENV Template (no real secrets)
# ============================================================

PORT=3001
FRONTEND_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
AWS_REGION=us-east-1

DYNAMO_TABLE=LoadBalancerLogs

# ─── Real Infrastructure (optional — needed for Infrastructure page) ──────────
# Leave blank to auto-detect default VPC + subnets
VPC_ID=
EC2_AMI=ami-0c02fb55956c7d316
EC2_INSTANCE_TYPE=t3.micro
EC2_KEY_PAIR=
